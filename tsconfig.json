{
	"compilerOptions": {
		"target": "ES2022",
		"module": "commonjs",
		"lib": [
			"ES2022"
		],
		"outDir": "dist",
		"rootDir": "./lib",
		"declaration": true,
		"skipLibCheck": true,
		"strict": false,
		"strictNullChecks": false,
		"strictPropertyInitialization": false,
		"types": [
			"vitest/globals",
			"node"
		],
		"esModuleInterop": true,
		"experimentalDecorators": true,
		"emitDecoratorMetadata": true
	},
	"include": [
		"lib/**/*"
	],
	"exclude": [
		"node_modules/"
	]
}
